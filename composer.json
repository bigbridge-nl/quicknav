{
    "name": "bigbridge/quicknav",
    "description": "BigBridge QuickNav: fast, ACL-aware admin search and navigation to products, categories, configuration, customers, orders, CMS and more from the admin dashboard.",
    "type": "magento2-module",
    "license": [
        "GPL-3.0-or-later"
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "hyva-themes/magento2-theme-module": "^1.5",
        "hyva-themes/commerce-module-admin-dashboard-api": "^3.0",
        "hyva-themes/commerce-module-admin-dashboard": "^2.0",
        "hyva-themes/commerce-theme-adminhtml": "^1.1",
        "hyva-themes/magento2-default-theme": "^1.5"
    },
    "suggest": {
        "bigbridge/core": "Shared BigBridge admin branding. QuickNav's settings merge into the tab it provides, and declare that tab themselves when it is absent."
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BigBridge\\QuickNav\\": ""
        }
    },
    "repositories": {
        "packagist.org": false
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true
        }
    },
    "version": "1.0.1"
}
