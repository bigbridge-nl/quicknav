<?php

declare(strict_types=1);

use Hyva\AdminDashboardApi\Api\V1\WidgetInstanceInterface;
use Magento\Backend\Block\Template;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template as ChildTemplate;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var WidgetInstanceInterface|null $widgetInstance */
$widgetInstance = $block->getData('widget_instance');

if (!$widgetInstance || !($data = $widgetInstance->getDisplayData())) {
    return;
}
?>
<div class="quicknav-widget-wrapper">
<?php
echo $block->getLayout()->createBlock(ChildTemplate::class)
    ->setTemplate('BigBridge_QuickNav::widget/search-panel.phtml')
    ->setData('search_url', $data['search_url'] ?? '')
    ->setData('user_id', $data['user_id'] ?? 0)
    ->setData('accessible_types', $data['accessible_types'] ?? [])
    ->toHtml();
?>
    <?php if ($data['show_branding'] ?? true): ?>
    <div class="quicknav-widget__branding">
        <a class="quicknav-widget__branding-link"
           href="https://www.bigbridge.nl/?utm_source=quicknav_module"
           target="_blank"
           rel="noopener noreferrer"
           title="<?= $escaper->escapeHtmlAttr(__('Powered by BigBridge')) ?>">
            <?= $escaper->escapeHtml(__('Powered by')) ?>
            <span class="quicknav-widget__branding-logo" role="img" aria-label="BigBridge"></span>
        </a>
    </div>
    <?php endif; ?>
</div>

