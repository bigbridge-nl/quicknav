<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="BigBridge_QuickNav">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Config"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Store"/>
            <module name="Magento_UrlRewrite"/>
            <module name="Magento_Indexer"/>
            <module name="Magento_Cron"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Sales"/>
            <module name="Magento_SalesRule"/>
            <module name="Hyva_AdminDashboardApi"/>
            <module name="Hyva_Theme"/>
            <!--
                Optional. A sequence entry only orders loading when the module is installed, and
                is ignored when it is not, so listing Core here does not make it a requirement.
                The ordering matters because Core also declares the shared bigbridge_tab.
            -->
            <module name="BigBridge_Core"/>
        </sequence>
    </module>
</config>
